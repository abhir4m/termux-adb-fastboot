#!/data/data/com.termux/files/usr/bin/bash

# termux-adb-fastboot :: installer
# github.com/abhir4m


RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

info() { echo -e "${CYAN}[*]${NC} $*"; }
step() { echo -e "${BLUE}[>]${NC} ${BOLD}$*${NC}"; }
ok()   { echo -e "${GREEN}[✔]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
fail() { echo -e "${RED}[✘]${NC} $*"; }
hr()   { echo -e "${DIM}------------------------------------------------------------${NC}"; }

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "adb & fastboot for Termux"
    echo -e "${NC}"
}

banner
hr

export DEBIAN_FRONTEND=noninteractive
if [ -z "$PREFIX" ]; then
    PREFIX="/data/data/com.termux/files/usr"
fi

# check device  architecture
arch=$(uname -m)
case "$arch" in
    aarch64) arch="aarch64" ;;
    armv7l|armv8l) arch="arm" ;;
    *)
        fail "Architecture ${BOLD}$arch${NC} is not supported."
        exit 1
        ;;
esac
ok "Detected architecture: ${BOLD}$arch${NC}"

# setup environment
step "Updating package lists & upgrading system"
apt-get update >/dev/null 2>&1 && apt-get upgrade -y >/dev/null 2>&1 \
    && ok "System updated" || warn "Update/upgrade had warnings (continuing)"

step "Installing base dependencies"
apt-get install -y wget curl ca-certificates gnupg coreutils >/dev/null 2>&1 \
    && ok "Base dependencies installed" || { fail "Could not install base dependencies"; exit 1; }

# ---------- runtime dependencies of termux-adb ----------
step "Installing runtime dependencies (brotli, libc++, liblz4, termux-api, zlib, zstd)"
apt-get install -y brotli libc++ liblz4 termux-api zlib zstd >/dev/null 2>&1 \
    && ok "Runtime dependencies installed" || warn "Some runtime deps may be missing (continuing)"

# ---------- download vendored termux-adb ----------
PKG_VERSION="0.2.3"
DEB_NAME="termux-adb_${PKG_VERSION}_${arch}.deb"
DEB_URL="https://raw.githubusercontent.com/abhir4m/termux-adb-fastboot/main/dists/termux/extras/binary-${arch}/${DEB_NAME}"
DEB_PATH="/tmp/${DEB_NAME}"

step "Downloading vendored termux-adb (${PKG_VERSION}) for ${arch}"
if curl -fsSL -o "$DEB_PATH" "$DEB_URL"; then
    ok "Downloaded ${DEB_NAME}"
else
    fail "Failed to download ${DEB_NAME}"
    exit 1
fi

step "Installing termux-adb"
if dpkg -i "$DEB_PATH" >/dev/null 2>&1; then
    ok "termux-adb installed"
else
    warn "dpkg reported issues; attempting to fix dependencies"
    apt-get install -f -y >/dev/null 2>&1
    dpkg -i "$DEB_PATH" >/dev/null 2>&1 && ok "termux-adb installed" || { fail "Failed to install termux-adb"; rm -f "$DEB_PATH"; exit 1; }
fi
rm -f "$DEB_PATH"


step "Creating command shortcuts (adb, fastboot)"
ln -sf "$PREFIX/bin/termux-fastboot" "$PREFIX/bin/fastboot"
ln -sf "$PREFIX/bin/termux-adb" "$PREFIX/bin/adb"
ok "Symbolic links created:"
echo -e "   ${DIM}termux-fastboot -> fastboot${NC}"
echo -e "   ${DIM}termux-adb      -> adb${NC}"


helper="$PREFIX/bin/termux-adb-u"
info "Installing self-update helper"
cat > "$helper" <<'EOF'
#!/bin/bash
curl -s https://raw.githubusercontent.com/abhir4m/termux-adb-fastboot/main/utermuxadb | bash
EOF
chmod +x "$helper"
ok "Self-update helper created at $helper"

hr
echo -e "${GREEN}${BOLD}done!${NC}"
echo -e "  ${GREEN}adb${NC} and ${GREEN}fastboot${NC} are ready to use."
echo -e "  Run ${CYAN}adb version${NC} / ${CYAN}fastboot --version${NC} to verify."
echo -e "  For Future upgrades: ${CYAN}termux-adb-u${NC}"
hr
