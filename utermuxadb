#!/data/data/com.termux/files/usr/bin/bash

# termux-adb-fastboot :: updater
# github.com/abhir4m

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

info() { echo -e "${CYAN}[*]${NC} $*"; }
step() { echo -e "${BLUE}[>]${NC} ${BOLD}$*${NC}"; }
ok()   { echo -e "${GREEN}[✔]${NC} $*"; }
warn() { echo -e "${YELLOW}[!]${NC} $*"; }
fail() { echo -e "${RED}[✘]${NC} $*"; }
hr()   { echo -e "${DIM}------------------------------------------------------------${NC}"; }

banner() {
    echo -e "${CYAN}${BOLD}"
    echo "Updating adb & fastboot for Termux"
    echo -e "${NC}"
}

banner
hr

if [ -z "$PREFIX" ]; then
    PREFIX="/data/data/com.termux/files/usr"
fi

arch=$(uname -m)
case "$arch" in
    aarch64) arch="aarch64" ;;
    armv7l|armv8l) arch="arm" ;;
    *)
        fail "Architecture ${BOLD}$arch${NC} is not supported."
        exit 1
        ;;
esac
ok "Detected architecture: ${BOLD}$arch${NC}"

main_repo=$(grep -E '^deb ' /data/data/com.termux/files/usr/etc/apt/sources.list 2>/dev/null | awk '{print $2}' | head -n 1)
[ -z "$main_repo" ] && main_repo="https://packages.termux.dev/apt/termux-main"

step "Checking internet connection"
while true; do
    if curl -s --max-time 10 "$main_repo" >/dev/null 2>&1; then
        ok "Internet connection OK"
        break
    else
        warn "No internet connection. Retrying in 5s..."
        sleep 5
    fi
done

step "Refreshing apt lists"
apt-get update >/dev/null 2>&1 && ok "apt lists refreshed" || warn "apt update warnings (continuing)"

PKG_VERSION="0.2.3"
DEB_NAME="termux-adb_${PKG_VERSION}_${arch}.deb"
DEB_URL="https://raw.githubusercontent.com/abhir4m/termux-adb-fastboot/main/dists/termux/extras/binary-${arch}/${DEB_NAME}"
TMP_DIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$TMP_DIR"
DEB_PATH="$TMP_DIR/${DEB_NAME}"

installed_version=$(pkg show termux-adb 2>/dev/null | grep '^Version:' | awk '{print $2}')

step "Checking termux-adb version"
if [ "$installed_version" = "$PKG_VERSION" ]; then
    ok "termux-adb is already the newest version (${PKG_VERSION})."
else
    info "Installed: ${installed_version:-none}  ->  Available: ${PKG_VERSION}"
    step "Downloading ${DEB_NAME}"
    if curl -fsSL -o "$DEB_PATH" "$DEB_URL"; then
        ok "Downloaded ${DEB_NAME}"
        step "Installing termux-adb ${PKG_VERSION}"
        if dpkg -i "$DEB_PATH" >/dev/null 2>&1; then
            ok "termux-adb updated"
        else
            warn "dpkg reported issues; fixing dependencies"
            apt-get install -f -y >/dev/null 2>&1
            dpkg -i "$DEB_PATH" >/dev/null 2>&1 && ok "termux-adb updated" || fail "Failed to update termux-adb"
        fi
        rm -f "$DEB_PATH"
    else
        fail "Failed to download ${DEB_NAME}"
    fi
fi

step "Refreshing command shortcuts (adb, fastboot)"
ln -sf "$PREFIX/bin/termux-fastboot" "$PREFIX/bin/fastboot" && ln -sf "$PREFIX/bin/termux-adb" "$PREFIX/bin/adb"
ok "Symbolic links updated:"
echo -e "   ${DIM}termux-fastboot -> fastboot${NC}"
echo -e "   ${DIM}termux-adb      -> adb${NC}"

packages=(
    "abseil-cpp"
    "termux-api"
    "libusb"
    "brotli"
    "libc++"
    "zlib"
    "zstd"
    "liblz4"
)

step "Checking supporting packages"
for package in "${packages[@]}"; do
    installed=$(apt policy "$package" 2>/dev/null | grep 'Installed' | awk '{print $2}')
    candidate=$(apt policy "$package" 2>/dev/null | grep 'Candidate' | awk '{print $2}')
    if [ -n "$installed" ] && [ "$installed" != "(none)" ] && [ "$installed" = "$candidate" ]; then
        ok "$package is already the newest version."
    else
        info "Updating $package..."
        apt-get install -y "$package" >/dev/null 2>&1 && ok "$package updated" || warn "Could not update $package (skipping)"
    fi
done

helper="$PREFIX/bin/termux-adb-u"
if [ ! -f "$helper" ]; then
    info "Installing self-update helper"
fi
cat > "$helper" <<'EOF'
#!/bin/bash
curl -s https://raw.githubusercontent.com/abhir4m/termux-adb-fastboot/main/utermuxadb | bash
EOF
chmod +x "$helper"
ok "Self-update helper ready at $helper"

hr
echo -e "${GREEN}${BOLD}done!${NC}"
hr
